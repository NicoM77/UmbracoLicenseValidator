{
  "name": "umbraco-license-validator",
  "version": "1.0.0",
  "description": "Check an Umbraco license key against a domain, straight from the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build:js": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=dist/app.js",
    "build:css": "esbuild src/app.css --bundle --minify --loader:.woff2=file --asset-names=[name] --outfile=dist/app.css",
    "build": "npm run typecheck && npm run build:js && npm run build:css",
    "watch": "npm run build:js -- --watch",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "@umbraco-ui/uui": "2.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
